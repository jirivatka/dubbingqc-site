  "narrative": {
    "northStar": "The Line-Up",
    "overview": "The page is the head of a delivery master: colour bars, a slate, burnt-in timecode, then the dub lined up against the original. The ground is near-black, corners square, display type a condensed character-generator face in caps, measurements in a mono. Each of the seven 75% bars owns one check family; the yellow flag marks findings only; dropped audio is an honest dashed gap.",
    "keyCharacteristics": [
      "Black ground, square corners, 1px rules and 2px ink borders; depth by tonal panel.",
      "Seven bars = seven families; colour carries meaning.",
      "Caps condensed display, humanist body, tabular mono for time and measurements.",
      "One clock drives timecode, playhead and flag highlight."
    ],
    "rules": [
      {
        "name": "The One Flag Rule",
        "body": "Yellow #f5d000 marks a finding. Never use it for buttons, links, decoration or brand emphasis.",
        "section": "colors"
      },
      {
        "name": "The Bar Owns Its Family Rule",
        "body": "A family's colour appears on its bar, its contents marker and nowhere that implies another family.",
        "section": "colors"
      },
      {
        "name": "The Contrast Green Rule",
        "body": "Text on green uses #127a52; the lighter bar green is for fills without text weight.",
        "section": "colors"
      },
      {
        "name": "The Mono Means Measured Rule",
        "body": "Anything that is a time, length or measurement is mono with tabular numerals; prose never is.",
        "section": "typography"
      },
      {
        "name": "The Caps Are Display Only Rule",
        "body": "Capitals belong to the Slate face; body copy stays sentence case.",
        "section": "typography"
      },
      {
        "name": "The Flat Unless Evidence Rule",
        "body": "Shadows exist only to lift a real screenshot off black or to light an active finding.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do give every check family its own bar colour and use it only for that family.",
      "Do set times and measurements in the TC mono with tabular numerals.",
      "Do draw dropped audio as a dashed red gap and shifted sync as a dashed yellow box.",
      "Do keep text on green at #127a52 with white.",
      "Do keep the focus ring yellow, 3px, offset 3px."
    ],
    "donts": [
      "Don't use #f5d000 for anything but a finding (and focus/selection, which are the same flag).",
      "Don't add rounded corners, cards, or glow outside the hot flag.",
      "Don't swap the button green for the bar green or the reverse.",
      "Don't run a second animation clock or any motion that survives reduced-motion."
    ]
  }
}